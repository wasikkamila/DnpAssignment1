@page "/posts/{Id:int}"
@inject IPostService PostService
@inject ICommentService CommentService

<PageTitle>@(post?.Title ?? "Post")</PageTitle>

@if (post is null)
{
    @if (error is not null)
    {
        <p class="text-danger">@error</p>
    }
    else
    {
        <p>Loading...</p>
    }
}
else
{
    <h1>@post.Title</h1>
    <p class="text-muted">by @post.UserName</p>
    <p style="white-space: pre-wrap">@post.Body</p>

    <h4 class="mt-4">Comments</h4>
    @if (post.Comments is null || post.Comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        <ul class="list-unstyled">
            @foreach (CommentDto comment in post.Comments)
            {
                <li class="mb-2"><strong>@comment.UserName</strong>: @comment.Body</li>
            }
        </ul>
    }

    <AuthorizeView>
        <Authorized>
            <div class="mt-3" style="max-width: 600px">
                <label class="form-label">Add a comment</label>
                <textarea class="form-control mb-2" rows="3" @bind="newComment" @bind:event="oninput"></textarea>
                @if (!string.IsNullOrEmpty(commentError))
                {
                    <p class="text-danger">@commentError</p>
                }
                <button class="btn btn-primary" @onclick="AddCommentAsync">Comment</button>
            </div>
        </Authorized>
        <NotAuthorized>
            <p class="mt-3"><a href="/login">Log in</a> to comment.</p>
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? State { get; set; }

    private PostDto? post;
    private string? error;
    private string newComment = "";
    private string? commentError;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            post = await PostService.GetPostAsync(Id, includeComments: true);
            error = null;
        }
        catch (Exception e)
        {
            post = null;
            error = e.Message;
        }
    }

    private async Task AddCommentAsync()
    {
        commentError = null;

        if (string.IsNullOrWhiteSpace(newComment))
        {
            commentError = "Write something first.";
            return;
        }

        int? userId = State is null ? null : (await State).User.GetUserId();
        if (userId is null)
        {
            commentError = "You must be logged in to comment.";
            return;
        }

        try
        {
            await CommentService.AddCommentAsync(new CreateCommentDto
            {
                Body = newComment,
                UserId = userId.Value,
                PostId = Id
            });
            newComment = "";
            await LoadAsync();
        }
        catch (Exception e)
        {
            commentError = e.Message;
        }
    }
}
